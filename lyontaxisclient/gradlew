#!/bin/sh

APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
DEFAULT_JVM_OPTS='-Xmx64m -Xms64m'
if [ -n "$JAVA_HOME" ]; then
  JAVA_EXE="$JAVA_HOME/bin/java"
else
  JAVA_EXE=java
fi
if ! command -v "$JAVA_EXE" >/dev/null 2>&1; then
  echo "ERROR: Java was not found. Install JDK 17 and set JAVA_HOME." >&2
  exit 1
fi
exec "$JAVA_EXE" $DEFAULT_JVM_OPTS $JAVA_OPTS $GRADLE_OPTS -classpath "$APP_HOME/gradle/wrapper/gradle-wrapper.jar" org.gradle.wrapper.GradleWrapperMain "$@"
